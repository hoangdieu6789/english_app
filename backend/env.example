PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/english_app?sslmode=disable
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_PEPPER=change-me-refresh-pepper
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Concurrent Azure calls. The Free (F0) tier allows 1; extra calls wait in line.
AZURE_SPEECH_CONCURRENCY=1
AUDIO_STORAGE_DIR=./data/audio
AUDIO_PUBLIC_URL_PREFIX=/uploads
OPENROUTER_API_KEY=
# Free models only (":free"). Free quota: 20 requests/min, 50/day (1000/day after buying 10 credits).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Comma-separated fallbacks, tried in the same request when the first model is busy. Must be free too.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# true = allow models without ":free" (they cost money). Keep false.
ALLOW_PAID_MODELS=false
# LLM providers tried in order, comma-separated: claude, gemini, openrouter.
#   claude: Claude Code logged in on your Mac (your own subscription, for your own local use
#           only) through the LLM bridge: see tools/llm-bridge/README.md.
#   gemini: Gemini API with GEMINI_API_KEY (free tier key from aistudio.google.com/api-keys).
#           A Google AI Pro subscription does not raise API limits; limits are per project and
#           per model (aistudio.google.com/rate-limit). Free-tier content may be used by Google
#           to improve its products.
# Example: LLM_PROVIDERS=claude,gemini,openrouter
LLM_PROVIDERS=openrouter
LLM_BRIDGE_URL=http://host.docker.internal:8765
# Shared secret between the API and the bridge (any random string, at least 16 characters).
LLM_BRIDGE_TOKEN=
# Claude Code model alias: sonnet (default), haiku (faster, lighter on usage limits), opus.
CLAUDE_MODEL=sonnet
GEMINI_API_KEY=
# Gemini API models, tried in order when one is busy (503), out of quota (429) or closed (404).
# gemini-flash-latest = current Flash model; the 2.5 models are closed to new users.
GEMINI_MODEL=gemini-flash-latest,gemini-3-flash-preview
# Speaking rubric (backend/internal/rubric)
# LLM for the transcript criteria of IELTS parts (FC, LR, GRA); empty = OPENROUTER_MODEL. Shadowing needs no LLM.
GRADER_MODEL=
# Pitch analysis for Pronunciation P-04 (needs: pip install praat-parselmouth numpy). Empty = off.
PITCH_PYTHON=
PITCH_SCRIPT=internal/rubric/pitch/pitch_direction.py
